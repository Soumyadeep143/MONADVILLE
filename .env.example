# Copy to .env — every default here runs the whole app with zero external services.

PORT=4000
NODE_ENV=development

# memory | mongo (mongo driver not implemented yet — see apps/server/src/persistence/mongo/README.md)
PERSISTENCE_DRIVER=memory
MONGODB_URI=

# memory | monad (monad driver not implemented yet — see apps/server/src/blockchain/MonadLedgerService.ts)
LEDGER_DRIVER=memory
MONAD_RPC_URL=
MONAD_LEDGER_ADDRESS=

# dev | supabase (supabase driver not implemented yet — see apps/server/src/auth/supabaseAuth.ts)
AUTH_DRIVER=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional — omit to run agent decisions on the deterministic fallback policy only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

CORS_ORIGIN=http://localhost:5173
