# Copy to .env — every default here runs the whole app with zero external services.

PORT=4000
NODE_ENV=development

# memory | mongo | supabase (mongo driver not implemented yet — see apps/server/src/persistence/mongo/README.md)
PERSISTENCE_DRIVER=memory
MONGODB_URI=

# memory | monad (monad driver not implemented yet — see apps/server/src/blockchain/MonadLedgerService.ts)
LEDGER_DRIVER=memory
MONAD_RPC_URL=
MONAD_LEDGER_ADDRESS=

# dev | supabase (supabase AUTH driver not implemented yet — see apps/server/src/auth/supabaseAuth.ts.
# SUPABASE_URL/SERVICE_ROLE_KEY below are independently required by PERSISTENCE_DRIVER=supabase.)
AUTH_DRIVER=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Dashboard > Project Settings > API > service_role secret. Server-side only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — omit to run agent decisions on the deterministic fallback policy only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Concurrent in-flight agent decision calls per cycle. Tuned for Groq's free
# tier (6000 TPM on llama-3.1-8b-instant); raise if your tier allows more.
DECISION_CONCURRENCY=4

CORS_ORIGIN=http://localhost:5173
